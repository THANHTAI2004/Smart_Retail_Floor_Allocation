{
  "schema_version": "1.0",
  "name": "failure-controls",
  "data_origin": "SYNTHETIC",
  "datasets": [
    {
      "id": "impossible",
      "scale": "tiny",
      "seed": 101,
      "scenario": "infeasible",
      "category_assignment": "free",
      "variable_facings": false,
      "levels": 2,
      "height_scale": 1.0,
      "input_path": null,
      "input_file_sha256": null
    }
  ],
  "experiments": [
    {
      "id": "E02",
      "question": "Do heuristic failure and proven infeasibility remain distinct and retained?",
      "hypothesis": "Greedy reports search exhaustion while MILP proves the intentionally oversized capacity case infeasible.",
      "datasets": [
        "impossible"
      ],
      "treatments": [
        {
          "id": "baseline",
          "overrides": {
            "optimization": {
              "algorithm": "greedy",
              "stop_after_stage": "T2"
            }
          }
        },
        {
          "id": "milp",
          "overrides": {
            "optimization": {
              "algorithm": "milp",
              "stop_after_stage": "T2"
            }
          }
        }
      ],
      "metrics": [
        "wall_s",
        "t2_objective"
      ],
      "acceptance": "Record all terminal failures with the correct stage and proof scope, without accepting a witness.",
      "statistical_method": "descriptive_paired_exploratory"
    }
  ],
  "seeds": [
    11,
    23
  ],
  "repetitions": 1,
  "job_time_limit_s": 15.0,
  "memory_limit_mb": 1024,
  "max_wall_s": 600.0,
  "max_jobs": 128,
  "max_retries": 1,
  "workers": 1,
  "cache_policy": "isolated"
}
