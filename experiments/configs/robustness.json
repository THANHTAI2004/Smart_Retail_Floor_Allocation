  "experiments": [
    {
      "id": "E09",
      "question": "How robust are routes to demand and SKU-weight perturbations?",
      "hypothesis": "Every accepted witness has zero independent constraint violations; treatment effects are evaluated rather than assumed.",
      "datasets": [
        "volatile",
        "uneven"
      ],
      "treatments": [
        {
          "id": "baseline",
          "overrides": {}
        },
        {
          "id": "exact",
          "overrides": {
            "demand": {
              "routing_policy": "exact"
            }
          }
        }
      ],
      "metrics": [
        "wall_s",
        "mean_distance_m",
        "mean_wait_s"
      ],
      "acceptance": "Zero independent replay violations; retain all failed and resource-limited outcomes.",
      "statistical_method": "descriptive_paired_exploratory"
    }
  ],
