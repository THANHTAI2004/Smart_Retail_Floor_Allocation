{
  "schema_version": "1.1",
  "name": "pilot_cv",
  "data_origin": "SYNTHETIC",
  "datasets": [
    {"id": "tiny_f6", "scale": "tiny", "seed": 101, "facings": 6},
    {"id": "small_f4", "scale": "small", "seed": 101, "facings": 4}
  ],
  "experiments": [
    {
      "id": "E16",
      "question": "How much time does one repeated k-fold job cost per method and scale, and do held-out objectives differ between methods?",
      "hypothesis": "Pilot only: measures wall time and variability to size the main campaigns; no efficacy claim.",
      "datasets": ["tiny_f6", "small_f4"],
      "treatments": [
        {
          "id": "baseline",
          "overrides": {"optimization": {"algorithm": "greedy", "slotting_algorithm": "first_fit", "candidate_count": 1,
            "joint": {"mode": "sequential", "objective": {"weights": [1, 0.2, 0.1, 0.1], "scales": [100, 100, 1, 1]},
              "scenario_seeds": [0, 101], "scenario_seed_policy": "job_seed_offsets", "max_iterations": 3, "max_evaluations": 80, "max_actions": 24}}}
        },
        {
          "id": "seq_milp",
          "overrides": {"optimization": {"algorithm": "milp", "slotting_algorithm": "milp", "candidate_count": 1,
            "joint": {"mode": "sequential", "objective": {"weights": [1, 0.2, 0.1, 0.1], "scales": [100, 100, 1, 1]},
              "scenario_seeds": [0, 101], "scenario_seed_policy": "job_seed_offsets", "max_iterations": 3, "max_evaluations": 80, "max_actions": 24}}}
        },
        {
          "id": "multistart",
          "overrides": {"optimization": {"algorithm": "milp", "slotting_algorithm": "milp", "candidate_count": 3,
            "joint": {"mode": "multistart", "objective": {"weights": [1, 0.2, 0.1, 0.1], "scales": [100, 100, 1, 1]},
              "scenario_seeds": [0, 101], "scenario_seed_policy": "job_seed_offsets", "max_iterations": 3, "max_evaluations": 80, "max_actions": 24}}}
        },
        {
          "id": "feedback",
          "overrides": {"optimization": {"algorithm": "milp", "slotting_algorithm": "milp", "candidate_count": 1,
            "joint": {"mode": "feedback", "objective": {"weights": [1, 0.2, 0.1, 0.1], "scales": [100, 100, 1, 1]},
              "scenario_seeds": [0, 101], "scenario_seed_policy": "job_seed_offsets", "max_iterations": 3, "max_evaluations": 80, "max_actions": 24}}}
        }
      ],
      "metrics": ["test_objective", "train_objective", "generalization_gap", "test_mean_distance_m", "test_mean_wait_s", "wall_s", "peak_child_rss_bytes"],
      "acceptance": "Zero independent violations on training and held-out replays; all failures and budget-limited evaluations retained.",
      "statistical_method": "descriptive_paired_exploratory"
    }
  ],
  "seeds": [1],
  "repetitions": 1,
  "job_time_limit_s": 60.0,
  "memory_limit_mb": 1024,
  "max_wall_s": 14400.0,
  "max_jobs": 80,
  "max_retries": 1,
  "workers": 1,
  "cache_policy": "isolated",
  "evaluation": {"split": "kfold", "n_folds": 10, "budget_fraction": 0.25}
}
