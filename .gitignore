# Generated experiment outcomes, reports and runtime data remain local.
/experiments/results/
/experiments/reports/

# Canonical experiment runtime artifacts remain local.
/experiments/runtime/
/experiments/databases/
/experiments/.migration-staging/
/experiments/migration/receipts/
/experiments/backups/

# Large migration inventories/logs are distributed with the experiment release.
/experiments/migration/audit-D-to-E-20261024T093214Z/D-inventory.json
/experiments/migration/audit-D-to-E-20261024T093214Z/E-inventory.json
/experiments/migration/duplicate-cleanup/file-actions.jsonl

# User decision 2026-10-27: share source/configs/docs, exclude experiment outcomes.
/experiments/*
!/experiments/configs/
!/experiments/docs/
!/experiments/scripts/
!/experiments/visualization/
!/experiments/*.py
!/experiments/*.md
# Summary evidence generated from completed phase-1 runs is an experiment outcome.
/experiments/configs/**/x1-union-spaces.json
