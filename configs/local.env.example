# SMART_RETAIL_ARTIFACTS=D:/Smart_Retail_Floor_Allocation/var/artifacts
# SMART_RETAIL_HOME=D:/Smart_Retail_Floor_Allocation
# For Compose, create root .env with POSTGRES_PASSWORD (URL-safe characters).
