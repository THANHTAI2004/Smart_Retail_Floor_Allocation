{
  "$defs": {
    "ArrivalPeriodInput": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "arrivals_per_hour": {
          "minimum": 0,
          "title": "Arrivals Per Hour",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "arrivals_per_hour"
      ],
      "title": "ArrivalPeriodInput",
      "type": "object"
    },
    "BehaviorInput": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "synthetic_basket",
          "default": "synthetic_basket",
          "title": "Model",
          "type": "string"
        },
        "speed_m_s": {
          "default": 1.2,
          "exclusiveMinimum": 0,
          "title": "Speed M S",
          "type": "number"
        },
        "dwell_s": {
          "default": 5,
          "minimum": 0,
          "title": "Dwell S",
          "type": "number"
        }
      },
      "title": "BehaviorInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "data_origin": {
      "default": "UNSPECIFIED",
      "enum": [
        "SYNTHETIC",
        "REAL_VERIFIED",
        "REAL_UNVERIFIED",
        "ASSUMED",
        "DERIVED",
        "UNSPECIFIED"
      ],
      "title": "Data Origin",
      "type": "string"
    },
    "arrivals_per_hour": {
      "default": 20,
      "exclusiveMinimum": 0,
      "title": "Arrivals Per Hour",
      "type": "number"
    },
    "horizon_s": {
      "default": 3600,
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Horizon S",
      "type": "number"
    },
    "customers": {
      "default": 20,
      "maximum": 10000,
      "minimum": 0,
      "title": "Customers",
      "type": "integer"
    },
    "baskets": {
      "items": {
        "items": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "type": "array"
      },
      "title": "Baskets",
      "type": "array"
    },
    "behavior": {
      "$ref": "#/$defs/BehaviorInput"
    },
    "periods": {
      "items": {
        "$ref": "#/$defs/ArrivalPeriodInput"
      },
      "maxItems": 168,
      "title": "Periods",
      "type": "array"
    },
    "picker_count": {
      "default": 1,
      "maximum": 100,
      "minimum": 1,
      "title": "Picker Count",
      "type": "integer"
    },
    "routing_policy": {
      "default": "nearest",
      "enum": [
        "nearest",
        "return",
        "exact"
      ],
      "title": "Routing Policy",
      "type": "string"
    }
  },
  "title": "DemandInput",
  "type": "object"
}
