{
  "$defs": {
    "DatasetSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "scale": {
          "default": "tiny",
          "enum": [
            "tiny",
            "small",
            "medium",
            "large"
          ],
          "title": "Scale",
          "type": "string"
        },
        "seed": {
          "default": 101,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "scenario": {
          "default": "feasible",
          "enum": [
            "feasible",
            "infeasible",
            "high_load",
            "volatile",
            "uneven"
          ],
          "title": "Scenario",
          "type": "string"
        },
        "category_assignment": {
          "default": "free",
          "enum": [
            "free",
            "fixed"
          ],
          "title": "Category Assignment",
          "type": "string"
        },
        "variable_facings": {
          "default": false,
          "title": "Variable Facings",
          "type": "boolean"
        },
        "facings": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Facings",
          "type": "integer"
        },
        "levels": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Levels",
          "type": "integer"
        },
        "height_scale": {
          "default": 1,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Height Scale",
          "type": "number"
        },
        "input_path": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Path"
        },
        "input_file_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input File Sha256"
        },
        "orders": {
          "anyOf": [
            {
              "maximum": 20000,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orders"
        },
        "order_interval_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 86400,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Interval S"
        },
        "picker_count": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Picker Count"
        }
      },
      "required": [
        "id"
      ],
      "title": "DatasetSpec",
      "type": "object"
    },
    "EvaluationSpec": {
      "additionalProperties": false,
      "description": "Repeated stratified k-fold or temporal holdout over orders (deepmg-style protocol).\n\nEach campaign seed is one repetition: it shuffles the folds and seeds the job.",
      "properties": {
        "split": {
          "enum": [
            "kfold",
            "temporal_holdout"
          ],
          "title": "Split",
          "type": "string"
        },
        "n_folds": {
          "default": 10,
          "maximum": 20,
          "minimum": 2,
          "title": "N Folds",
          "type": "integer"
        },
        "test_size": {
          "default": 0.2,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Test Size",
          "type": "number"
        },
        "budget_fraction": {
          "default": 0.25,
          "maximum": 0.5,
          "minimum": 0.05,
          "title": "Budget Fraction",
          "type": "number"
        },
        "stratify": {
          "const": "dominant_category",
          "default": "dominant_category",
          "title": "Stratify",
          "type": "string"
        },
        "order_rate": {
          "anyOf": [
            {
              "const": "population",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Rate"
        }
      },
      "required": [
        "split"
      ],
      "title": "EvaluationSpec",
      "type": "object"
    },
    "ExperimentSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^E\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 5,
          "title": "Question",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 5,
          "title": "Hypothesis",
          "type": "string"
        },
        "datasets": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Datasets",
          "type": "array"
        },
        "treatments": {
          "items": {
            "$ref": "#/$defs/Treatment"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Treatments",
          "type": "array"
        },
        "metrics": {
          "default": [
            "wall_s",
            "mean_distance_m",
            "mean_wait_s"
          ],
          "items": {
            "enum": [
              "wall_s",
              "peak_child_rss_bytes",
              "mean_distance_m",
              "mean_wait_s",
              "t2_objective",
              "t3_objective",
              "t1_objective",
              "joint_objective",
              "joint_evaluations",
              "joint_iterations_to_best",
              "holdout_objective",
              "joint_evaluations_to_best",
              "train_objective",
              "test_objective",
              "test_mean_distance_m",
              "test_mean_wait_s",
              "generalization_gap"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "acceptance": {
          "minLength": 5,
          "title": "Acceptance",
          "type": "string"
        },
        "statistical_method": {
          "const": "descriptive_paired_exploratory",
          "default": "descriptive_paired_exploratory",
          "title": "Statistical Method",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "hypothesis",
        "datasets",
        "treatments",
        "acceptance"
      ],
      "title": "ExperimentSpec",
      "type": "object"
    },
    "Treatment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": true,
          "title": "Overrides",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Treatment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "data_origin": {
      "const": "SYNTHETIC",
      "default": "SYNTHETIC",
      "title": "Data Origin",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/DatasetSpec"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Datasets",
      "type": "array"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/ExperimentSpec"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Experiments",
      "type": "array"
    },
    "seeds": {
      "default": [
        11,
        23,
        37
      ],
      "items": {
        "type": "integer"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "repetitions": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "job_time_limit_s": {
      "default": 15.0,
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Job Time Limit S",
      "type": "number"
    },
    "memory_limit_mb": {
      "default": 1024,
      "maximum": 8192,
      "minimum": 128,
      "title": "Memory Limit Mb",
      "type": "integer"
    },
    "max_wall_s": {
      "default": 600.0,
      "exclusiveMinimum": 0,
      "maximum": 14400,
      "title": "Max Wall S",
      "type": "number"
    },
    "max_jobs": {
      "default": 128,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Jobs",
      "type": "integer"
    },
    "max_retries": {
      "default": 1,
      "maximum": 2,
      "minimum": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "workers": {
      "const": 1,
      "default": 1,
      "title": "Workers",
      "type": "integer"
    },
    "cache_policy": {
      "default": "isolated",
      "enum": [
        "isolated",
        "reuse"
      ],
      "title": "Cache Policy",
      "type": "string"
    },
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "datasets",
    "experiments"
  ],
  "title": "CampaignSpec",
  "type": "object"
}
