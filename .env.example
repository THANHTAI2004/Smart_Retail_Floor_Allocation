MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=smart_retail
SMART_RETAIL_ARTIFACTS=var/artifacts
# Compose requires credentials in a private .env; do not commit that file.
MONGODB_ROOT_USER=retail
MONGODB_ROOT_PASSWORD=replace-with-a-private-password
# Optional isolated Compose verification ports; do not share production ports.
SMART_RETAIL_API_PORT=8010
SMART_RETAIL_WEB_PORT=5173
# Never place the actual authenticated URI in this example or any report.
